    def commit(self) -> str:

        values = {
            'type': 'POST',
            'params': {
                'type': 'commit',
                'cmd': f'<commit></commit>'
            },
            'headers': {
                'X-PAN-KEY': self.key,
            }
        }

        commit_data = self._make_request(values)
        commit_root = ET.fromstring(commit_data.text)
        jobid = commit_root.find('.//job').text

        return jobid
    
