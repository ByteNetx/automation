{
    "security_rules": [
        {
            "name": "allow-web-to-database",
            "description": "Allow web servers to access database",
            "source_zones": ["dmz"],
            "destination_zones": ["database"],
            "source_addresses": ["web-servers"],
            "destination_addresses": ["db-server-01"],
            "applications": ["mysql", "postgresql"],
            "services": ["any"],
            "action": "allow",
            "log_start": false,
            "log_end": true,
            "tags": ["web", "database"]
        },
        {
            "name": "block-social-media",
            "description": "Block social media access",
            "source_zones": ["trust"],
            "destination_zones": ["untrust"],
            "source_addresses": ["any"],
            "destination_addresses": ["any"],
            "applications": ["ssl", "web-browsing"],
            "services": ["any"],
            "url_categories": ["Social_Media"],
            "action": "deny",
            "log_end": true,
            "tags": ["social-media", "block"]
        }
    ]
}
