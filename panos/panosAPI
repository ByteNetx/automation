import xml.etree.ElementTree as ET
import json
from requests import request,packages, Response
from requests.exceptions import SSLError, HTTPError, Timeout, TooManyRedirects

class PaloAltoAPI:

    def __init__(self, host: str, username: str=None, password: str=None, api_key: str=None):

        self.host = host
        self.username = username
        self.password = password
        if not api_key:
            self.key = self.get_api_key()
        else:
            self.key = api_key
        self.version = self.get_system_info().find('.//sw-version').text

    def _make_request(self, values, verify=False, timeout=300) -> Response:

        packages.urllib3.disable_warnings()

        url = f'https://{self.host}/api'

        try:

            req_type = values['type']
            params = values['params']
            headers = values['headers']
            ver = verify
            time = timeout

        except KeyError as err:
            print(f'Expected 3 values, missing one or more: {err}')
            return None

        try:

            req = request(
                req_type,
                url=url,
                headers=headers,
                params=params,
                verify=ver,
                timeout=time
            )

            req.raise_for_status()
            return req

        except (SSLError, Timeout, ConnectionError, TooManyRedirects) as err:
            print(f'API call failed due to {err}')
            return req

    def _make_rest_request(self, values, endpoint, verify=False, timeout=300) -> Response:

        packages.urllib3.disable_warnings()

        rest_ver = self._rest_panos_formatter()
        url = f'https://{self.host}/restapi/v{rest_ver}/{endpoint}'

        try:

            req_type = values['type']
            params = values['params']
            headers = values['headers']
            data = values['data']
            ver = verify
            time = timeout

        except KeyError as err:
            print(f'Expected 4 values, missing one or more: {err}')
            return None

        req = request(
                req_type,
                url=url,
                headers=headers,
                params=params,
                json=data,
                verify=ver,
                timeout=time
            )

        return req

    def _rest_panos_formatter(self):
        temp_split = self.version.split('.')
        formatted = f'{temp_split[0]}.{temp_split[1]}'
        return formatted


    def get_api_key(self):
        '''
        Returns API key for specified user/password

        :param host: String containing device hostname/address
        :param username: Username string
        :param password: Password string
        :return: API Key
        '''

        values = {
            'type': 'POST',
            'params': {
                'type': 'keygen',
                'user': self.username,
                'password': self.password
            },
            'headers': None
        }

        data = self._make_request(values)
        root = ET.fromstring(data.text)
        api_key = root.find('./result/key').text
        return api_key

    def get_system_info(self, serial: str=None):
        '''
        Get system info

        :param host: String containing Panorama Hostname/Address
        :param key: String containing API Key
        :return: Response object
        '''

        values = {
            'type': 'GET',
            'params': {
                'type': 'op',
                'action': 'get',
                'cmd': '<show><system><info></info></system></show>',
                'target': serial
            },
            'headers': {
                'X-PAN-KEY': self.key,
            }
        }

        data = self._make_request(values)
        info_root = ET.fromstring(data.text)

        return info_root
    

    def address_objects(self, action: str, objects: str, location: str, new_config: str = None, new_name: str = None) -> Response:

        if new_name:
            endpoint = 'Objects/Addresses:rename'
        else:
            endpoint = 'Objects/Addresses'
        
        if objects == 'all':
            object_name = None
        else:
            object_name = objects

        loc_type = 'device-group' if location != 'shared' else 'shared'
        device_group = None if loc_type == 'shared' else location

        values = {
            'type': action,
            'data': new_config,
            'params': {
                'name': object_name,
                'location': loc_type,
                'device-group': device_group,
                'newname': new_name
            },
            'headers': {
                'X-PAN-KEY': self.key,
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        }
        return self._make_rest_request(values, endpoint)
    
