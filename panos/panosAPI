    def request_portal_config(self, username: str, password: str, satellite: str, serial: str = None) -> Response:

        values = {
            'type': 'POST',
            'params': {
                'type': 'op',
                'action': 'get',
                'cmd': f'<request><global-protect-satellite><get-portal-config><username>{username}</username><password>{password}</password><satellite>{satellite}</satellite></get-portal-config></global-protect-satellite></request>',
                'target': serial
            },
            'headers': {
                'X-PAN-KEY': self.key,
            }
        }

        return self._make_request(values)
    
    def get_tunnel_info(self, serial: str = None) -> Response:
        '''
        Gets all IPSec tunnels

        :param host: String containing Panorama Hostname/Address
        :param key: String containing API Key
        :return: Response object
        '''

        values = {
            'type': 'POST',
            'params': {
                'type': 'config',
                'action': 'get',
                'xpath': "/config/devices/entry[@name='localhost.localdomain']/network/tunnel/ipsec",
                'target': serial
            },
            'headers': {
                'X-PAN-KEY': self.key,
            }
        }

        tunnel_info_data = self._make_request(values)
        tunnel_info_root = ET.fromstring(tunnel_info_data.text)

        return tunnel_info_root
    
