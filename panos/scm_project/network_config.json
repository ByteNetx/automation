{
  "TIER1-EW-OB": {
    "type": "folder",
    "ethernet-interfaces": [
      {
        "name": "$AWS_PA_PRIVATE_IF",
        "default_value": "ethernet1/1",
        "layer3": {
          "dhcp_client": {
            "create_default_route": false,
            "enable": true,
            "send_hostname": {
              "enable": true,
              "hostname": "system-hostname"
            }
          },
          "interface_management_profile": "health-checks",
          "lldp": {
            "enable": false
          }
        },
        "link_state": "auto"
      },
      {
        "name": "$AWS_PA_PUBLIC_IF",
        "default_value": "ethernet1/2",
        "layer3": {
          "dhcp_client": {
            "create_default_route": true,
            "enable": true,
            "send_hostname": {
              "enable": true,
              "hostname": "system-hostname"
            }
          },
          "lldp": {
            "enable": false
          }
        }
      }
    ],
    "layer3-subinterfaces": [
      {
        "name": "$AWS_PA_PRIVATE_IF.20",
        "parent_interface": "$AWS_PA_PRIVATE_IF",
        "comment": "Create by SCM API 0831",
        "tag": 20,
        "interface_management_profile": "",
        "dhcp_client": {
          "create_default_route": false,
          "default_route_metric": 10,
          "enable": true,
          "send_hostname": {
            "enable": false,
            "hostname": "system-hostname"
          }
        }
      },
      {
        "name": "$AWS_PA_PRIVATE_IF.30",
        "parent_interface": "$AWS_PA_PRIVATE_IF",
        "comment": "Create by SCM API 0831",
        "tag": 30,
        "dhcp_client": {
          "create_default_route": false,
          "default_route_metric": 10,
          "enable": true,
          "send_hostname": {
            "enable": false,
            "hostname": "system-hostname"
          }
        }
      }
    ],
    "logical-routers": [
      {
        "name": "LR-T1-EW-OB",
        "routing_stack": "advanced",
        "vrf": [
          {
            "interface": [
              "$AWS_PA_PUBLIC_IF",
              "$AWS_PA_PRIVATE_IF",
              "$AWS_PA_PRIVATE_IF.20",
              "$AWS_PA_PRIVATE_IF.30"
            ],
            "name": "default",
            "routing_table": {
              "ip": {
                "static_route": [
                  {
                    "destination": "0.0.0.0/0",
                    "interface": "$AWS_PA_PUBLIC_IF",
                    "metric": 10,
                    "name": "default-route",
                    "nexthop": {
                      "ip_address": "$AWS_PA_PUBLIC_GW_IP"
                    }
                  },
                  {
                    "destination": "10.0.0.0/8",
                    "interface": "$AWS_PA_PRIVATE_IF",
                    "metric": 10,
                    "name": "aws-spokes",
                    "nexthop": {
                      "ip_address": "$AWS_PA_PRIVATE_GW_IP"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    ],
    "zones": [
      {
        "name": "private",
        "network": {
          "enable_packet_buffer_protection": true,
          "layer3": [
            "$AWS_PA_PRIVATE_IF.20",
            "$AWS_PA_PRIVATE_IF.30"
          ],
          "log_setting": "Cortex Data Lake",
          "zone_protection_profile": "best-practice"
        }
      },
      {
        "name": "internal",
        "network": {
          "enable_packet_buffer_protection": true,
          "layer3": [
            "$AWS_PA_PRIVATE_IF"
          ],
          "log_setting": "Cortex Data Lake",
          "zone_protection_profile": "best-practice"
        }
      },
      {
        "name": "public",
        "network": {
          "enable_packet_buffer_protection": true,
          "layer3": [
            "$AWS_PA_PUBLIC_IF"
          ],
          "log_setting": "Cortex Data Lake",
          "zone_protection_profile": "best-practice"
        }
      }
    ]
  }
}
